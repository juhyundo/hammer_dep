# Virtual environment
.venv/
venv/

# Airflow config (contains credentials)
airflow.cfg
logs/
airflow.db

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/

# Log files
*.log

# Wheels directory (not needed for from-source builds)
wheels/

# Chipyard (separate git repo, cloned during setup)
chipyard/

# Airflow generated files
simple_auth_manager_passwords.json.generated
standalone_admin_password.txt

# DAGs: gitignore everything in dags/ except the canonical demo.
# Auto-generated DAGs (hammer_<design>_dag.py from make-dag) and per-design
# hand-copies (sledgehammer_<design>_synpar.py) all land here and are not
# meant to be committed.
dags/*.py
!dags/pd_store_demo.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
e2e/build-sky130-cm/

# Per-user workspaces (created by Airflow per LDAP user)
e2e/build-sky130-cm-*/

# Per-DAG-run cache event logs (consumed and cleaned up by the exit_ task)
cache_events/

output.json
